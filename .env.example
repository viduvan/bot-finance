# ============================================================
# ACTA Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_ENV=development
DEBUG=true
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://acta:acta_secret@localhost:5432/acta

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Security (MUST CHANGE IN PRODUCTION) ─────────────────────
JWT_SECRET=change-me-use-openssl-rand-hex-32
APPROVAL_TOKEN_SECRET=change-me-approval-token-secret
ENCRYPTION_KEY=change-me-32-byte-encryption-key

# ── Trading ──────────────────────────────────────────────────
TRADING_MODE=PAPER

# ── Binance API Keys ────────────────────────────────────────
# Read-only key (for market data - used by agents)
BINANCE_READ_API_KEY=
BINANCE_READ_API_SECRET=

# Trading key (for order execution - ONLY used by Execution Service)
BINANCE_TRADE_API_KEY=
BINANCE_TRADE_API_SECRET=

# Use testnet by default
BINANCE_TESTNET=true

# ── LLM Providers ───────────────────────────────────────────
# Gemini API (primary - recommended)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Ollama (local fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# OpenAI API (fallback 2)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

LLM_TEMPERATURE=0.1
# Fallback chain priority: gemini → openai → ollama
LLM_FALLBACK_CHAIN=gemini,openai,ollama

# ── Telegram Notifications ──────────────────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── MFA ──────────────────────────────────────────────────────
MFA_ENABLED=true
